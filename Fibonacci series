import java.util.Scanner;

public class Fibonacci {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of terms: ");
        int n = sc.nextInt();

        if (n < 0 || n > 94) {
            System.out.println("Enter a number from 0 to 94.");
        } else {
            long a = 0, b = 1;

            for (int i = 0; i < n; i++) {
                System.out.print(a + " ");

                if (i < n - 1) {
                    long next = a + b;
                    a = b;
                    b = next;
                }
            }
        }

        sc.close();
    }
}
